# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Stuntman Chris raw art drop (1.8GB source renders — runtime assets are generated
# into public/images/games/stuntman-chris by scripts/build-stuntman-chris-assets.ts)
public/images/games/meebel-knievel/

# Late-arriving raw art drop — packed by scripts/pack-robot-obstacles.ts; raw frames must not ship (meebel-knievel precedent)
public/images/games/stuntman-chris/sheets/Robot_Obstacles/
